<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="@color/sidebar_selected" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/surface_high" /><corners android:radius="12dp" /></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /></shape></item>
</selector>

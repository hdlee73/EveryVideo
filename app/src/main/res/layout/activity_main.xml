<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFile"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:text="@string/open_file" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenUrl"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:text="@string/open_url" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDrive"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:text="@string/google_drive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnServers"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:text="@string/servers" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConcat"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:text="@string/concat" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecord"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:text="@string/screen_record" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookmarks"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="1"
            android:text="@string/bookmarks_all" />
    </GridLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="@string/recent"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_recent"
        android:visibility="gone" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill_dark"
        android:gravity="center"
        android:minWidth="180dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/indicatorIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/indicatorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/indicatorBar"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:visibility="gone"
            app:indicatorColor="@android:color/white"
            app:trackColor="#40FFFFFF"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/overlay"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/PlayerIcon"
                android:contentDescription="뒤로"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnSpeed"
                style="@style/PlayerText"
                android:text="1.0x" />

            <TextView
                android:id="@+id/btnSpeedReset"
                style="@style/PlayerText"
                android:contentDescription="원래 속도로"
                android:text="1x로"
                android:textColor="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnAb"
                style="@style/PlayerText"
                android:text="A-B" />

            <ImageButton
                android:id="@+id/btnRepeat"
                style="@style/PlayerIcon"
                android:alpha="0.5"
                android:contentDescription="반복"
                android:src="@drawable/ic_repeat" />

            <ImageButton
                android:id="@+id/btnTracks"
                style="@style/PlayerIcon"
                android:contentDescription="자막/음성"
                android:src="@drawable/ic_tracks" />

            <ImageButton
                android:id="@+id/btnAspect"
                style="@style/PlayerIcon"
                android:contentDescription="화면 비율"
                android:src="@drawable/ic_aspect" />

            <ImageButton
                android:id="@+id/btnQueue"
                style="@style/PlayerIcon"
                android:contentDescription="재생목록"
                android:src="@drawable/ic_queue" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/sectionPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_pill_dark"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sectionInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/sectionClose"
                    style="@style/PlayerIcon"
                    android:contentDescription="구간 편집 닫기"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/secIn"
                        style="@style/PlayerChip"
                        android:drawableStart="@drawable/ic_mark_in"
                        android:text="시작" />

                    <TextView
                        android:id="@+id/secOut"
                        style="@style/PlayerChip"
                        android:drawableStart="@drawable/ic_mark_out"
                        android:text="끝" />

                    <TextView
                        android:id="@+id/secList"
                        style="@style/PlayerChip"
                        android:drawableStart="@drawable/ic_list"
                        android:text="목록" />

                    <TextView
                        android:id="@+id/secSave"
                        style="@style/PlayerChip"
                        android:drawableStart="@drawable/ic_save"
                        android:text="저장" />

                    <TextView
                        android:id="@+id/secDelete"
                        style="@style/PlayerChip"
                        android:drawableStart="@drawable/ic_delete"
                        android:text="구간 삭제" />

                    <TextView
                        android:id="@+id/secGif"
                        style="@style/PlayerChip"
                        android:drawableStart="@drawable/ic_gif"
                        android:text="GIF" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/overlay"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="시간으로 이동"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:text="00:00"
                    android:textColor="@android:color/white" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1">

                    <androidx.media3.ui.DefaultTimeBar
                        android:id="@+id/timeBar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:ad_marker_color="@color/accent"
                        app:ad_marker_width="4dp"
                        app:bar_height="5dp"
                        app:played_ad_marker_color="@color/accent"
                        app:played_color="@color/brand"
                        app:scrubber_color="@color/brand"
                        app:scrubber_disabled_size="0dp"
                        app:scrubber_dragged_size="24dp"
                        app:scrubber_enabled_size="16dp"
                        app:touch_target_height="48dp" />

                    <com.everyvideo.player.ui.SectionBar
                        android:id="@+id/sectionBar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="56dp"
                    android:text="00:00"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrev"
                    style="@style/PlayerIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="이전"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/btnRew"
                    style="@style/PlayerIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="10초 뒤로"
                    android:src="@drawable/ic_replay10" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    style="@style/PlayerIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="재생"
                    android:padding="12dp"
                    android:src="@drawable/ic_pause" />

                <ImageButton
                    android:id="@+id/btnFwd"
                    style="@style/PlayerIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="10초 앞으로"
                    android:src="@drawable/ic_forward10" />

                <ImageButton
                    android:id="@+id/btnNext"
                    style="@style/PlayerIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="다음"
                    android:src="@drawable/ic_next" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnLock"
                        style="@style/PlayerIcon"
                        android:contentDescription="화면 잠금"
                        android:src="@drawable/ic_lock" />

                    <ImageButton
                        android:id="@+id/btnAdjust"
                        style="@style/PlayerIcon"
                        android:contentDescription="밝기와 볼륨"
                        android:src="@drawable/ic_brightness" />

                    <ImageButton
                        android:id="@+id/btnCapture"
                        style="@style/PlayerIcon"
                        android:contentDescription="캡쳐"
                        android:src="@drawable/ic_camera" />

                    <ImageButton
                        android:id="@+id/btnThumb"
                        style="@style/PlayerIcon"
                        android:contentDescription="썸네일 만들기"
                        android:src="@drawable/ic_image" />

                    <ImageButton
                        android:id="@+id/btnClip"
                        style="@style/PlayerIcon"
                        android:contentDescription="구간 편집 (저장·삭제·GIF)"
                        android:src="@drawable/ic_cut" />

                    <ImageButton
                        android:id="@+id/btnBookmarkAdd"
                        style="@style/PlayerIcon"
                        android:contentDescription="즐겨찾기 추가"
                        android:src="@drawable/ic_bookmark_add" />

                    <ImageButton
                        android:id="@+id/btnBookmarks"
                        style="@style/PlayerIcon"
                        android:contentDescription="즐겨찾기 목록"
                        android:src="@drawable/ic_bookmarks" />

                    <ImageButton
                        android:id="@+id/btnRotate"
                        style="@style/PlayerIcon"
                        android:contentDescription="화면 회전"
                        android:src="@drawable/ic_rotate" />

                    <ImageButton
                        android:id="@+id/btnPip"
                        style="@style/PlayerIcon"
                        android:contentDescription="작은 창"
                        android:src="@drawable/ic_pip" />

                    <ImageButton
                        android:id="@+id/btnFullscreen"
                        style="@style/PlayerIcon"
                        android:contentDescription="전체화면"
                        android:src="@drawable/ic_fullscreen" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="104dp"
        android:background="@android:color/black"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="2dp"
        android:visibility="invisible">

        <TextureView
            android:id="@+id/previewTexture"
            android:layout_width="192dp"
            android:layout_height="108dp" />

        <TextView
            android:id="@+id/previewTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="2dp"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/zoomChip"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_pill_dark"
        android:drawablePadding="6dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/adjustPanel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="176dp"
        android:background="@drawable/bg_pill_dark"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_brightness"
                app:tint="@android:color/white" />

            <com.google.android.material.slider.Slider
                android:id="@+id/brightnessSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="밝기"
                android:stepSize="1"
                android:valueFrom="-50"
                android:valueTo="200"
                android:value="50"
                app:labelBehavior="gone" />

            <TextView
                android:id="@+id/brightnessValue"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_volume"
                app:tint="@android:color/white" />

            <com.google.android.material.slider.Slider
                android:id="@+id/volumeSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="볼륨"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="50"
                app:labelBehavior="gone" />

            <TextView
                android:id="@+id/volumeValue"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/brightnessAuto"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="밝기를 시스템 설정으로"
            android:textColor="#FFBFC3FF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/queuePanel"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_panel_dark"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="재생목록"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/queueInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/queueSort"
                style="@style/PlayerIcon"
                android:contentDescription="정렬"
                android:src="@drawable/ic_sort" />

            <ImageButton
                android:id="@+id/queueAdd"
                style="@style/PlayerIcon"
                android:contentDescription="동영상 추가"
                android:src="@drawable/ic_add" />

            <ImageButton
                android:id="@+id/queueSave"
                style="@style/PlayerIcon"
                android:contentDescription="재생목록 저장"
                android:src="@drawable/ic_save" />

            <ImageButton
                android:id="@+id/queueClose"
                style="@style/PlayerIcon"
                android:contentDescription="닫기"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnUnlock"
        style="@style/PlayerIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:background="@color/overlay"
        android:contentDescription="잠금 해제"
        android:src="@drawable/ic_lock"
        android:visibility="gone" />
</FrameLayout>
